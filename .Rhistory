gap_change ~ valence_gap_lag1 + (1 | conversation_id),
data = df_cond
)
coefs <- summary(model)$coefficients
within_results[[as.character(cond)]] <- tibble(
condition = cond,
estimate = coefs["valence_gap_lag1", "Estimate"],
se = coefs["valence_gap_lag1", "Std. Error"],
t = coefs["valence_gap_lag1", "t value"],
p = coefs["valence_gap_lag1", "Pr(>|t|)"]
)
}
within_summary <- bind_rows(within_results)
within_summary %>%
mutate(
sig = case_when(
p < 0.001 ~ "***",
p < 0.01 ~ "**",
p < 0.05 ~ "*",
p < 0.1 ~ ".",
TRUE ~ ""
)
) %>%
knitr::kable(
digits = 3,
caption = "Rubber-band slopes by condition"
)
within_summary %>%
mutate(
ci_lower = estimate - 1.96 * se,
ci_upper = estimate + 1.96 * se
) %>%
ggplot(aes(x = condition, y = estimate, fill = condition)) +
geom_col(width = 0.6, alpha = 0.8) +
geom_errorbar(aes(ymin = ci_lower, ymax = ci_upper), width = 0.2) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
scale_fill_manual(values = condition_colors) +
labs(
title = "Rubber-Band Effect by Condition",
subtitle = "More negative slopes indicate stronger re-convergence after divergence",
x = "Condition",
y = "Rubber-Band Slope"
) +
theme(legend.position = "none")
model_cross <- lmer(
gap_change ~ valence_gap_lag1 * condition + (1 | conversation_id),
data = df_analysis
)
cat("Cross-condition model summary:\n")
print(summary(model_cross))
emm_slopes <- emtrends(model_cross, specs = "condition", var = "valence_gap_lag1")
cat("\nCondition-specific slopes:\n")
print(emm_slopes)
cat("\nPairwise slope contrasts:\n")
print(pairs(emm_slopes, adjust = "bonferroni"))
df_analysis %>%
ggplot(aes(x = valence_gap_lag1, y = gap_change, color = condition)) +
geom_point(alpha = 0.05, size = 0.5) +
geom_smooth(method = "lm", se = TRUE, linewidth = 1.1) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray50") +
scale_color_manual(values = condition_colors) +
labs(
title = "Rubber-Band Effect by Condition",
subtitle = "Negative slope indicates re-convergence after divergence",
x = "Previous Valence Gap",
y = "Gap Change"
) +
theme(legend.position = "bottom")
df_analysis %>%
group_by(condition) %>%
summarise(
n_turns = n(),
mean_gap = mean(valence_gap, na.rm = TRUE),
sd_gap = sd(valence_gap, na.rm = TRUE),
mean_gap_change = mean(gap_change, na.rm = TRUE),
sd_gap_change = sd(gap_change, na.rm = TRUE),
rubber_band_r = cor(valence_gap_lag1, gap_change, use = "complete.obs"),
.groups = "drop"
) %>%
knitr::kable(
digits = 3,
caption = "Gap and gap-change descriptives by condition"
)
p_gap_density <- df_analysis %>%
ggplot(aes(x = valence_gap, fill = condition)) +
geom_density(alpha = 0.5) +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray50") +
scale_fill_manual(values = condition_colors) +
labs(
title = "Valence Gap Distribution",
subtitle = "Slot 1 minus Slot 2",
x = "Valence Gap",
y = "Density"
) +
theme(legend.position = "none")
p_gap_box <- df_analysis %>%
ggplot(aes(x = condition, y = valence_gap, fill = condition)) +
geom_violin(alpha = 0.5) +
geom_boxplot(width = 0.2, alpha = 0.8, outlier.alpha = 0.1) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
scale_fill_manual(values = condition_colors) +
labs(
title = "Valence Gap by Condition",
x = "Condition",
y = "Valence Gap"
) +
theme(legend.position = "none")
p_gap_density + p_gap_box
df_analysis %>%
ggplot(aes(x = valence_gap_lag1, y = gap_change, color = condition)) +
geom_point(alpha = 0.03, size = 0.5) +
geom_smooth(method = "lm", se = TRUE, linewidth = 1) +
facet_wrap(~story_phase) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
scale_color_manual(values = condition_colors) +
labs(
title = "Rubber-Band Dynamics Across Story Phases",
x = "Previous Valence Gap",
y = "Gap Change"
) +
theme(legend.position = "bottom")
knitr::opts_chunk$set(
echo = FALSE,
warning = FALSE,
message = FALSE,
fig.width = 10,
fig.height = 6,
dpi = 300
)
source(here::here("analysis/comparison/_comparison_utils.R"))
pacman::p_load(
lme4,
lmerTest,
patchwork,
emmeans,
effectsize
)
theme_set(theme_comparison())
df_raw <- load_novelty_data(c("human-ai", "human-human", "ai-ai")) %>%
filter_complete_exchange_window() %>%
filter(turn_index > 1) %>%
filter(conversation_id != "conv_ed575a06c11d42358e3eeb7826d2f959", conversation_id != "conv_a63a08273d0a4704a7638e4cd6850225", conversation_id != "conv_0bb56093-3033-4615-bb70-ebfa4135589a", conversation_id != "conv_0f18b30f-7d4b-4681-b98e-a0ff4f2b5256", conversation_id != "conv_72218cb5-e59c-4c93-a4b9-a057fe5dad80", conversation_id != "conv_7c23347e-6172-4c84-9fd0-45ef34290bd5")
df_raw %>%
group_by(condition) %>%
summarise(
n_stories = n_distinct(conversation_id),
n_turns = n(),
.groups = "drop"
) %>%
knitr::kable(caption = "Loaded novelty data by condition")
df_slots <- bind_rows(
df_raw %>%
transmute(
condition,
conversation_id,
turn_index,
slot = "author_1",
role_label = case_when(
condition == "human-ai" ~ str_to_title(author_1_type),
starter_side == "author_1" ~ "Starter-side",
TRUE ~ "Non-starter-side"
),
surprise = author_1_surprise,
transience = author_1_transience,
resonance = author_1_surprise - author_1_transience
),
df_raw %>%
transmute(
condition,
conversation_id,
turn_index,
slot = "author_2",
role_label = case_when(
condition == "human-ai" ~ str_to_title(author_2_type),
starter_side == "author_2" ~ "Starter-side",
TRUE ~ "Non-starter-side"
),
surprise = author_2_surprise,
transience = author_2_transience,
resonance = author_2_surprise - author_2_transience
)
) %>%
drop_na(surprise, transience, resonance) %>%
mutate(
condition = factor(
condition,
levels = c("human-ai", "human-human", "ai-ai"),
labels = c("Human-AI", "Human-Human", "AI-AI")
),
slot = factor(slot, levels = c("author_1", "author_2"), labels = c("Slot 1", "Slot 2"))
)
df_long <- df_slots %>%
pivot_longer(
cols = c(surprise, transience, resonance),
names_to = "metric",
values_to = "value"
) %>%
mutate(
metric = factor(metric, levels = c("surprise", "transience", "resonance"))
)
cat("Slot-level rows:", nrow(df_slots), "\n")
cat("Metric rows:", nrow(df_long), "\n")
# Fit resonance ~ surprise * slot + (1|story) within each condition.
# The magnitude of the slope difference between slots is A_influence(condition).
slope_results <- purrr::map_dfr(levels(df_slots$condition), function(cond) {
df_cond <- df_slots %>% filter(condition == cond)
if (nrow(df_cond) < 50 || n_distinct(df_cond$conversation_id) < 5) {
return(tibble())
}
# Ensure slot is a 2-level factor with sum contrasts for interpretable interaction
df_cond$slot <- factor(df_cond$slot, levels = c("Slot 1", "Slot 2"))
contrasts(df_cond$slot) <- contr.sum(2)
model <- tryCatch(
lmer(
resonance ~ surprise * slot + (1 | conversation_id),
data = df_cond,
control = lmerControl(optimizer = "bobyqa")
),
error = function(e) NULL
)
if (is.null(model)) return(tibble())
slopes <- as.data.frame(emtrends(model, specs = "slot", var = "surprise"))
contrast_df <- as.data.frame(
contrast(emtrends(model, specs = "slot", var = "surprise"),
method = "revpairwise")
)
tibble(
condition = cond,
slope_slot1 = slopes$surprise.trend[slopes$slot == "Slot 1"],
slope_slot2 = slopes$surprise.trend[slopes$slot == "Slot 2"],
signed_diff = contrast_df$estimate[1],
se = contrast_df$SE[1],
t = contrast_df$t.ratio[1],
p = contrast_df$p.value[1],
A_influence = abs(contrast_df$estimate[1])
)
})
slope_results %>%
mutate(
sig = case_when(
p < 0.001 ~ "***",
p < 0.01 ~ "**",
p < 0.05 ~ "*",
p < 0.1 ~ ".",
TRUE ~ ""
)
) %>%
knitr::kable(
digits = 3,
caption = "Primary: |slope_1 - slope_2| from resonance ~ surprise * slot per condition"
)
# Sanity: A_influence is unsigned magnitude
stopifnot(all(slope_results$A_influence >= 0))
if (nrow(slope_results) > 0) {
slope_results %>%
mutate(
ci_lower = A_influence - 1.96 * se,
ci_upper = A_influence + 1.96 * se
) %>%
ggplot(aes(x = condition, y = A_influence, fill = condition)) +
geom_col(width = 0.6, alpha = 0.85) +
geom_errorbar(aes(ymin = pmax(ci_lower, 0), ymax = ci_upper), width = 0.18) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
scale_fill_manual(values = condition_colors) +
labs(
title = "A_influence by condition",
subtitle = "|slope(resonance~surprise) diff between slot 1 and slot 2| (LMM, story random intercept)",
x = "Condition",
y = expression("|" * Delta * beta * "|")
) +
theme(legend.position = "none")
}
# Pooled LMM in the same shape as the per-condition fits, used here only to
# extract the unsigned magnitude |slope_slot1 - slope_slot2| per condition.
# Signed slot direction is not article-primary because Slot 1 / Slot 2 are
# positional in HH and AA.
pooled_slope_model <- lmer(
resonance ~ surprise * slot * condition + (1 | conversation_id),
data = df_slots
)
pooled_slope_trends <- emtrends(
pooled_slope_model,
specs = ~ condition * slot,
var = "surprise"
)
pooled_unsigned_slot_gaps <- as.data.frame(
contrast(pooled_slope_trends, method = "revpairwise", by = "condition")
) %>%
transmute(
condition,
A_influence = abs(estimate),
se = SE
)
pooled_unsigned_slot_gaps %>%
knitr::kable(
digits = 3,
caption = "Pooled model: |slope_slot1 - slope_slot2| (unsigned) by condition"
)
# Robustness: per-story OLS slope difference. Each story needs >= 4 points per slot.
per_story_slope_diff <- df_slots %>%
group_by(condition, conversation_id, slot) %>%
summarise(
n_points = sum(!is.na(surprise) & !is.na(resonance)),
slope = if (n_points >= 4) {
coef(lm(resonance ~ surprise))[2]
} else {
NA_real_
},
.groups = "drop"
) %>%
select(condition, conversation_id, slot, slope) %>%
pivot_wider(names_from = slot, values_from = slope, names_prefix = "slope_") %>%
drop_na(`slope_Slot 1`, `slope_Slot 2`) %>%
mutate(
signed_diff = `slope_Slot 1` - `slope_Slot 2`,
A_influence_story = abs(signed_diff)
)
per_story_slope_diff %>%
group_by(condition) %>%
summarise(
n_stories = n(),
median_A = median(A_influence_story),
mean_A = mean(A_influence_story),
.groups = "drop"
) %>%
knitr::kable(
digits = 3,
caption = "Robustness: per-story |slope_1 - slope_2| (OLS per story, \u2265 4 points per slot)"
)
if (n_distinct(per_story_slope_diff$condition) >= 2 && nrow(per_story_slope_diff) >= 10) {
cat("\nKruskal-Wallis on per-story A_influence:\n")
print(kruskal.test(A_influence_story ~ condition, data = per_story_slope_diff))
cat("\nPairwise Wilcoxon on per-story A_influence (BH-adjusted):\n")
print(pairwise.wilcox.test(
per_story_slope_diff$A_influence_story,
per_story_slope_diff$condition,
p.adjust.method = "BH"
))
}
bootstrap_condition_means(per_story_slope_diff, "A_influence_story", R = 10000) %>%
knitr::kable(
digits = 3,
caption = "Bootstrap 95% CI on per-condition mean of per-story A_influence (R = 10,000)"
)
effect_sizes_pairwise(per_story_slope_diff, "A_influence_story") %>%
knitr::kable(
digits = 3,
caption = "Pairwise Cliff's delta on per-story A_influence"
)
planned_contrast_HA_vs_same(per_story_slope_diff, "A_influence_story") %>%
knitr::kable(
digits = 3,
caption = "Planned contrast: per-story A_influence in HA vs the average of HH and AA"
)
ds_nov <- directional_stability(per_story_slope_diff, "signed_diff")
ds_nov$by_condition %>%
knitr::kable(
digits = 3,
caption = "Per-condition directional stability of signed novelty-resonance asymmetry"
)
cat(sprintf(
"Brown-Forsythe variance-equality p = %.4f\n", ds_nov$variance_equality_p
))
ggplot(per_story_slope_diff, aes(x = condition, y = signed_diff, fill = condition)) +
geom_violin(alpha = 0.4, colour = NA) +
geom_boxplot(width = 0.2, outlier.shape = NA, alpha = 0.9) +
geom_jitter(width = 0.08, alpha = 0.35, size = 0.9) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
scale_fill_manual(values = condition_colors) +
labs(
title = "Signed novelty-resonance slope asymmetry by condition",
subtitle = "slope_slot1 - slope_slot2 per story",
x = "Condition",
y = expression(Delta * beta)
) +
theme(legend.position = "none")
pick_word_count_col <- function(prefix, df) {
candidates <- c(
paste0(prefix, "_word_count"),
paste0(prefix, "_n_words"),
paste0(prefix, "_nwords"),
paste0(prefix, "_text_qc_word_count")
)
hit <- candidates[candidates %in% names(df)]
if (length(hit) == 0) NA_character_ else hit[[1]]
}
a1_wc <- pick_word_count_col("author_1", df_raw)
a2_wc <- pick_word_count_col("author_2", df_raw)
if (!is.na(a1_wc) && !is.na(a2_wc)) {
df_slots_nwords <- bind_rows(
df_raw %>%
transmute(
condition, conversation_id, turn_index,
slot = "author_1",
surprise = author_1_surprise,
transience = author_1_transience,
resonance = author_1_surprise - author_1_transience,
nwords = .data[[a1_wc]]
),
df_raw %>%
transmute(
condition, conversation_id, turn_index,
slot = "author_2",
surprise = author_2_surprise,
transience = author_2_transience,
resonance = author_2_surprise - author_2_transience,
nwords = .data[[a2_wc]]
)
) %>%
drop_na(surprise, resonance, nwords) %>%
mutate(
condition = factor(condition,
levels = c("human-ai", "human-human", "ai-ai"),
labels = c("Human-AI", "Human-Human", "AI-AI")
),
slot = factor(slot, levels = c("author_1", "author_2"), labels = c("Slot 1", "Slot 2"))
)
length_controlled <- purrr::map_dfr(levels(df_slots_nwords$condition), function(cond) {
df_cond <- df_slots_nwords %>% filter(condition == cond)
if (nrow(df_cond) < 50) return(tibble())
contrasts(df_cond$slot) <- contr.sum(2)
model <- tryCatch(
lmer(resonance ~ surprise * slot + nwords + (1 | conversation_id), data = df_cond,
control = lmerControl(optimizer = "bobyqa")),
error = function(e) NULL
)
if (is.null(model)) return(tibble())
contrast_df <- as.data.frame(
contrast(emtrends(model, specs = "slot", var = "surprise"), method = "revpairwise")
)
tibble(
condition = cond,
A_influence_lc = abs(contrast_df$estimate[1]),
se = contrast_df$SE[1],
p = contrast_df$p.value[1]
)
})
length_controlled %>%
knitr::kable(
digits = 3,
caption = "Length-controlled |slope_slot1 - slope_slot2| (resonance ~ surprise * slot + nwords)"
)
} else {
cat("No author_1/author_2 word-count columns found in df_raw; length-controlled variant skipped.\n")
}
df_long %>%
group_by(condition, metric) %>%
summarise(
n_stories = n_distinct(conversation_id),
n_obs = n(),
mean_value = mean(value, na.rm = TRUE),
sd_value = sd(value, na.rm = TRUE),
.groups = "drop"
) %>%
knitr::kable(
digits = 3,
caption = "Overall novelty metrics by condition"
)
df_long %>%
ggplot(aes(x = value, fill = condition)) +
geom_density(alpha = 0.5) +
scale_fill_manual(values = condition_colors) +
facet_wrap(~metric, scales = "free", ncol = 1) +
labs(
title = "Novelty Metric Distributions by Condition",
x = "Metric Value",
y = "Density"
) +
theme(legend.position = "bottom")
for (metric_name in levels(df_long$metric)) {
cat("\n===", metric_name, "===\n")
model <- lmer(value ~ condition + (1 | conversation_id), data = filter(df_long, metric == metric_name))
print(summary(model))
print(pairs(emmeans(model, specs = "condition"), adjust = "bonferroni"))
}
innovation_model <- lmer(
resonance ~ surprise * condition + (1 | conversation_id),
data = df_slots
)
cat("Novelty-to-resonance model:\n")
print(summary(innovation_model))
cat("\nCondition-specific novelty-to-resonance slopes:\n")
print(emtrends(innovation_model, specs = "condition", var = "surprise"))
df_slots %>%
ggplot(aes(x = surprise, y = resonance, color = condition)) +
geom_point(alpha = 0.08, size = 0.6) +
geom_smooth(method = "lm", se = TRUE, linewidth = 1.1) +
scale_color_manual(values = condition_colors) +
labs(
title = "Novelty vs Resonance by Condition",
subtitle = "One novelty-to-resonance slope per condition",
x = "Novelty / Surprise",
y = "Resonance"
) +
theme(legend.position = "bottom")
df_slots %>%
pivot_longer(
cols = c(surprise, transience, resonance),
names_to = "metric",
values_to = "value"
) %>%
ggplot(aes(x = role_label, y = value, fill = role_label)) +
geom_boxplot(alpha = 0.8, outlier.alpha = 0.1) +
facet_grid(metric ~ condition, scales = "free_y") +
labs(
title = "Role-Conditioned Novelty Metrics",
subtitle = "Within-condition role view only: Human / AI in Human-AI; Starter-side / Non-starter-side in same-type conditions",
x = NULL,
y = "Metric Value"
) +
theme(legend.position = "none")
