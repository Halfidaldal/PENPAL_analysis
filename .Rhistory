x = "Slot 1 Valence (t)",
y = "Slot 2 Valence (t)"
)
p_cross_turn + p_same_turn + plot_layout(guides = "collect") &
theme(legend.position = "bottom")
slopes_df <- as.data.frame(slopes_by_condition) %>%
mutate(
ci_lower = predictor_z.trend - 1.96 * SE,
ci_upper = predictor_z.trend + 1.96 * SE
)
ggplot(slopes_df, aes(x = condition, y = predictor_z.trend, fill = alignment_direction)) +
geom_col(position = position_dodge(width = 0.8), width = 0.7, alpha = 0.85) +
geom_errorbar(
aes(ymin = ci_lower, ymax = ci_upper),
position = position_dodge(width = 0.8),
width = 0.25
) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
scale_fill_manual(
values = c("Slot 1 → Slot 2" = "#377EB8", "Slot 2(t-1) → Slot 1" = "#FF7F00")
) +
labs(
title = "Alignment Coefficients by Condition and Direction",
subtitle = "Standardized slopes with 95% confidence intervals",
x = "Condition",
y = "Alignment Coefficient (β)",
fill = "Direction"
) +
theme(legend.position = "bottom")
knitr::opts_chunk$set(
echo = FALSE,
warning = FALSE,
message = FALSE,
fig.width = 10,
fig.height = 6,
dpi = 300
)
source(here::here("analysis/comparison/_comparison_utils.R"))
pacman::p_load(
lme4,
lmerTest,
patchwork,
emmeans,
effectsize
)
theme_set(theme_comparison())
df_raw <- load_novelty_data(c("human-ai", "human-human", "ai-ai")) %>%
filter_complete_exchange_window()
df_raw %>%
group_by(condition) %>%
summarise(
n_stories = n_distinct(conversation_id),
n_turns = n(),
.groups = "drop"
) %>%
knitr::kable(caption = "Loaded novelty data by condition")
df_slots <- bind_rows(
df_raw %>%
transmute(
condition,
conversation_id,
turn_index,
slot = "author_1",
role_label = case_when(
condition == "human-ai" ~ str_to_title(author_1_type),
starter_side == "author_1" ~ "Starter-side",
TRUE ~ "Non-starter-side"
),
surprise = author_1_surprise,
transience = author_1_transience,
resonance = author_1_surprise - author_1_transience
),
df_raw %>%
transmute(
condition,
conversation_id,
turn_index,
slot = "author_2",
role_label = case_when(
condition == "human-ai" ~ str_to_title(author_2_type),
starter_side == "author_2" ~ "Starter-side",
TRUE ~ "Non-starter-side"
),
surprise = author_2_surprise,
transience = author_2_transience,
resonance = author_2_surprise - author_2_transience
)
) %>%
drop_na(surprise, transience, resonance) %>%
mutate(
condition = factor(
condition,
levels = c("human-ai", "human-human", "ai-ai"),
labels = c("Human-AI", "Human-Human", "AI-AI")
),
slot = factor(slot, levels = c("author_1", "author_2"), labels = c("Slot 1", "Slot 2"))
)
df_long <- df_slots %>%
pivot_longer(
cols = c(surprise, transience, resonance),
names_to = "metric",
values_to = "value"
) %>%
mutate(
metric = factor(metric, levels = c("surprise", "transience", "resonance"))
)
cat("Slot-level rows:", nrow(df_slots), "\n")
cat("Metric rows:", nrow(df_long), "\n")
slot_asymmetry <- purrr::map_dfr(levels(df_long$metric), function(metric_name) {
df_metric <- df_long %>%
filter(metric == metric_name)
model <- lmer(value ~ slot * condition + (1 | conversation_id), data = df_metric)
emm <- emmeans(model, specs = c("condition", "slot"))
emm_df <- as.data.frame(emm)
contrast_df <- as.data.frame(pairs(emm, by = "condition"))
tibble(
metric = metric_name,
condition = contrast_df$condition,
slot_1_mean = purrr::map_dbl(
contrast_df$condition,
~ emm_df$emmean[emm_df$condition == .x & emm_df$slot == "Slot 1"][1]
),
slot_2_mean = purrr::map_dbl(
contrast_df$condition,
~ emm_df$emmean[emm_df$condition == .x & emm_df$slot == "Slot 2"][1]
),
difference = contrast_df$estimate,
se = contrast_df$SE,
t = contrast_df$t.ratio,
p = contrast_df$p.value
)
})
slot_asymmetry %>%
mutate(
sig = case_when(
p < 0.001 ~ "***",
p < 0.01 ~ "**",
p < 0.05 ~ "*",
p < 0.1 ~ ".",
TRUE ~ ""
)
) %>%
knitr::kable(
digits = 3,
caption = "Slot asymmetry by condition for novelty metrics"
)
slot_asymmetry %>%
ggplot(aes(x = condition, y = difference, fill = condition)) +
geom_col(width = 0.6, alpha = 0.8) +
geom_errorbar(
aes(ymin = difference - 1.96 * se, ymax = difference + 1.96 * se),
width = 0.2
) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
scale_fill_manual(values = condition_colors) +
facet_wrap(~metric, scales = "free_y") +
labs(
title = "Slot Asymmetry by Condition",
subtitle = "Difference: Slot 1 - Slot 2. This is the primary cross-condition asymmetry comparison.",
x = "Condition",
y = "Asymmetry"
) +
theme(legend.position = "none")
df_long %>%
group_by(condition, metric) %>%
summarise(
n_stories = n_distinct(conversation_id),
n_obs = n(),
mean_value = mean(value, na.rm = TRUE),
sd_value = sd(value, na.rm = TRUE),
.groups = "drop"
) %>%
knitr::kable(
digits = 3,
caption = "Overall novelty metrics by condition"
)
df_long %>%
ggplot(aes(x = value, fill = condition)) +
geom_density(alpha = 0.5) +
scale_fill_manual(values = condition_colors) +
facet_wrap(~metric, scales = "free", ncol = 1) +
labs(
title = "Novelty Metric Distributions by Condition",
x = "Metric Value",
y = "Density"
) +
theme(legend.position = "bottom")
for (metric_name in levels(df_long$metric)) {
cat("\n===", metric_name, "===\n")
model <- lmer(value ~ condition + (1 | conversation_id), data = filter(df_long, metric == metric_name))
print(summary(model))
print(pairs(emmeans(model, specs = "condition"), adjust = "bonferroni"))
}
innovation_model <- lmer(
resonance ~ surprise * condition + (1 | conversation_id),
data = df_slots
)
cat("Novelty-to-resonance model:\n")
print(summary(innovation_model))
cat("\nCondition-specific novelty-to-resonance slopes:\n")
print(emtrends(innovation_model, specs = "condition", var = "surprise"))
df_slots %>%
ggplot(aes(x = surprise, y = resonance, color = condition)) +
geom_point(alpha = 0.08, size = 0.6) +
geom_smooth(method = "lm", se = TRUE, linewidth = 1.1) +
scale_color_manual(values = condition_colors) +
labs(
title = "Novelty vs Resonance by Condition",
subtitle = "One novelty-to-resonance slope per condition",
x = "Novelty / Surprise",
y = "Resonance"
) +
theme(legend.position = "bottom")
df_slots %>%
pivot_longer(
cols = c(surprise, transience, resonance),
names_to = "metric",
values_to = "value"
) %>%
ggplot(aes(x = role_label, y = value, fill = role_label)) +
geom_boxplot(alpha = 0.8, outlier.alpha = 0.1) +
facet_grid(metric ~ condition, scales = "free_y") +
labs(
title = "Role-Conditioned Novelty Metrics",
subtitle = "Within-condition role view only: Human / AI in Human-AI; Starter-side / Non-starter-side in same-type conditions",
x = NULL,
y = "Metric Value"
) +
theme(legend.position = "none")
knitr::opts_chunk$set(
echo = FALSE,
warning = FALSE,
message = FALSE,
fig.width = 10,
fig.height = 6,
dpi = 300
)
source(here::here("analysis/comparison/_comparison_utils.R"))
pacman::p_load(
lme4,
lmerTest,
patchwork,
emmeans
)
theme_set(theme_comparison())
df_combined <- load_exploration_data(c("human-ai", "human-human", "ai-ai")) %>%
prepare_condition_factor(reference = "human-ai")
df_combined %>%
group_by(condition, agent) %>%
summarise(
n_stories = n_distinct(conversation_id),
n_rows = n(),
min_k = min(k, na.rm = TRUE),
max_k = max(k, na.rm = TRUE),
.groups = "drop"
) %>%
knitr::kable(caption = "Loaded semantic exploration rows by condition and agent view")
df_interleaved <- df_combined %>%
filter(agent == "interleaved") %>%
drop_na(distance, k)
df_speaker <- df_combined %>%
filter(agent != "interleaved") %>%
filter(speaker_slot %in% c("author_1", "author_2")) %>%
mutate(
slot = factor(speaker_slot, levels = c("author_1", "author_2"), labels = c("Slot 1", "Slot 2"))
) %>%
drop_na(distance, k)
cat("Interleaved rows:", nrow(df_interleaved), "\n")
cat("Speaker rows:", nrow(df_speaker), "\n")
speaker_asymmetry_model <- lmer(
distance ~ k + slot * condition + (1 | conversation_id),
data = df_speaker
)
cat("Speaker-slot asymmetry model:\n")
print(summary(speaker_asymmetry_model))
speaker_asymmetry_emm <- emmeans(
speaker_asymmetry_model,
specs = c("condition", "slot")
)
speaker_asymmetry <- as.data.frame(pairs(speaker_asymmetry_emm, by = "condition")) %>%
transmute(
condition,
difference = estimate,
se = SE,
t = t.ratio,
p = p.value
)
speaker_asymmetry %>%
knitr::kable(
digits = 3,
caption = "Speaker-slot asymmetry in semantic exploration by condition"
)
speaker_asymmetry %>%
ggplot(aes(x = condition, y = difference, fill = condition)) +
geom_col(width = 0.6, alpha = 0.8) +
geom_errorbar(
aes(ymin = difference - 1.96 * se, ymax = difference + 1.96 * se),
width = 0.2
) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
scale_fill_manual(values = condition_colors) +
labs(
title = "Speaker-Slot Asymmetry by Condition",
subtitle = "Difference: Slot 1 - Slot 2. This is the primary cross-condition asymmetry comparison.",
x = "Condition",
y = "Asymmetry in Semantic Distance"
) +
theme(legend.position = "none")
speaker_summary <- df_speaker %>%
group_by(condition, slot, k) %>%
summarise(
mean_distance = mean(distance, na.rm = TRUE),
se_distance = sd(distance, na.rm = TRUE) / sqrt(n()),
.groups = "drop"
)
ggplot(speaker_summary, aes(x = k, y = mean_distance, color = slot)) +
geom_line(linewidth = 1) +
geom_point(size = 1.8) +
geom_ribbon(
aes(ymin = mean_distance - 1.96 * se_distance,
ymax = mean_distance + 1.96 * se_distance,
fill = slot),
alpha = 0.15,
color = NA
) +
facet_wrap(~condition) +
labs(
title = "Speaker-Level Semantic Exploration by Slot",
subtitle = "Slot trajectories shown first because asymmetry is the primary comparison target",
x = "Lag Bin (k)",
y = "Semantic Distance",
color = "Slot",
fill = "Slot"
) +
theme(legend.position = "bottom")
df_interleaved %>%
group_by(condition, k) %>%
summarise(
mean_distance = mean(distance, na.rm = TRUE),
sd_distance = sd(distance, na.rm = TRUE),
n = n(),
.groups = "drop"
) %>%
knitr::kable(
digits = 3,
caption = "Interleaved semantic distance by lag and condition"
)
interleaved_summary <- df_interleaved %>%
group_by(condition, k) %>%
summarise(
mean_distance = mean(distance, na.rm = TRUE),
se_distance = sd(distance, na.rm = TRUE) / sqrt(n()),
.groups = "drop"
)
ggplot(interleaved_summary, aes(x = k, y = mean_distance, color = condition)) +
geom_line(linewidth = 1.1) +
geom_point(size = 2) +
geom_ribbon(
aes(ymin = mean_distance - 1.96 * se_distance,
ymax = mean_distance + 1.96 * se_distance,
fill = condition),
alpha = 0.18,
color = NA
) +
scale_color_manual(values = condition_colors) +
scale_fill_manual(values = condition_colors) +
labs(
title = "Interleaved Semantic Exploration by Lag",
subtitle = "Mean distance with 95% confidence intervals",
x = "Lag Bin (k)",
y = "Semantic Distance"
) +
theme(legend.position = "bottom")
model_interleaved <- lmer(
distance ~ k * condition + (1 | conversation_id),
data = df_interleaved
)
cat("Interleaved model summary:\n")
print(summary(model_interleaved))
emm_interleaved <- emmeans(model_interleaved, specs = "condition")
cat("\nCondition contrasts (interleaved view):\n")
print(pairs(emm_interleaved, adjust = "bonferroni"))
df_speaker %>%
group_by(condition, condition_role, k) %>%
summarise(
mean_distance = mean(distance, na.rm = TRUE),
n = n(),
.groups = "drop"
) %>%
knitr::kable(
digits = 3,
caption = "Speaker-level semantic distance by condition, role, and lag"
)
role_summary <- df_speaker %>%
filter(!is.na(condition_role)) %>%
group_by(condition, condition_role, k) %>%
summarise(
mean_distance = mean(distance, na.rm = TRUE),
se_distance = sd(distance, na.rm = TRUE) / sqrt(n()),
.groups = "drop"
)
ggplot(role_summary, aes(x = k, y = mean_distance, color = condition_role)) +
geom_line(linewidth = 1) +
geom_point(size = 1.8) +
geom_ribbon(
aes(ymin = mean_distance - 1.96 * se_distance,
ymax = mean_distance + 1.96 * se_distance,
fill = condition_role),
alpha = 0.15,
color = NA
) +
facet_wrap(~condition) +
labs(
title = "Speaker-Level Semantic Exploration by Role",
subtitle = "Within-condition role view only: Human / AI in Human-AI; Starter-side / Non-starter-side in same-type conditions",
x = "Lag Bin (k)",
y = "Semantic Distance",
color = "Role",
fill = "Role"
) +
theme(legend.position = "bottom")
view_summary <- bind_rows(
df_interleaved %>%
mutate(view = "Interleaved sequence") %>%
select(condition, conversation_id, k, distance, view),
df_speaker %>%
mutate(view = "Speaker-specific") %>%
select(condition, conversation_id, k, distance, view)
) %>%
group_by(condition, view, k) %>%
summarise(
mean_distance = mean(distance, na.rm = TRUE),
.groups = "drop"
)
ggplot(view_summary, aes(x = k, y = mean_distance, color = condition)) +
geom_line(linewidth = 1) +
geom_point(size = 1.8) +
facet_wrap(~view) +
scale_color_manual(values = condition_colors) +
labs(
title = "Interleaved vs Speaker-Specific Semantic Distance",
x = "Lag Bin (k)",
y = "Mean Semantic Distance"
) +
theme(legend.position = "bottom")
knitr::opts_chunk$set(
echo = FALSE,
warning = FALSE,
message = FALSE,
fig.width = 10,
fig.height = 6,
dpi = 300
)
