arrange(turn, .by_group = TRUE) %>%
mutate(
ai_embedding_prev = lag(ai_embedding),
user_embedding_prev = lag(user_embedding)
) %>%
rowwise() %>%
mutate(
cosine_sim_same = cosine_sim(user_embedding, ai_embedding),
cosine_sim_prev = cosine_sim(user_embedding, ai_embedding_prev),
cosine_sim_user_self = cosine_sim(user_embedding, user_embedding_prev),
cosine_sim_ai_self = cosine_sim(ai_embedding, ai_embedding_prev)
) %>%
select(-user_embedding, -ai_embedding, -user_embedding_prev, -ai_embedding_prev) %>%
ungroup()
# Add lagged AI valence for simulated data
df_simulated <- df_simulated %>%
group_by(conversation_id) %>%
arrange(turn, .by_group = TRUE) %>%
mutate(
ai_valence_lag1 = lag(ai_valence, n = 1),
user_valence_lag1 = lag(user_valence, n = 1)
) %>%
ungroup()
# Verify no cross-story contamination
cat("=== Lag Variable Verification ===\n")
cat("Field data - Turn 1 with non-NA lag (should be 0):",
sum(df_field$turn == 1 & !is.na(df_field$ai_valence_lag1)), "\n")
cat("Simulated data - Turn 1 with non-NA lag (should be 0):",
sum(df_simulated$turn == 1 & !is.na(df_simulated$ai_valence_lag1)), "\n")
# Field data token statistics
token_stats_field <- df_field %>%
summarise(
mean_user_tokens = mean(user_token_count, na.rm = TRUE),
sd_user_tokens = sd(user_token_count, na.rm = TRUE),
mean_ai_tokens = mean(ai_token_count, na.rm = TRUE),
sd_ai_tokens = sd(ai_token_count, na.rm = TRUE),
mean_token_ratio = mean(token_ratio, na.rm = TRUE)
)
cat("=== Field Data Token Statistics ===\n")
print(token_stats_field)
knitr::opts_chunk$set(
echo = FALSE,
warning = FALSE,
message = FALSE,
fig.width = 10,
fig.height = 6,
dpi = 300
)
# Load comparison utilities
source(here::here("analysis/comparison/_comparison_utils.R"))
# Additional packages
pacman::p_load(
lme4,         # Mixed effects models
lmerTest,     # P-values for mixed models
patchwork,    # Combine plots
emmeans,      # Estimated marginal means
effectsize    # Effect size calculations
)
# Set global theme
theme_set(theme_comparison())
# Check data availability
cat("Data availability:\n")
avail <- check_data_availability()
print(avail)
# Load valence data using standardized loader
df_combined <- tryCatch({
load_valence_data(conditions = c("human-ai", "human-human", "ai-ai"))
}, error = function(e) {
# Fallback: try loading whatever is available
conditions_available <- c()
for (cond in c("human-ai", "human-human", "ai-ai")) {
path <- here("data", cond, "processed", "dyadic_sentiment_scores.parquet")
if (file.exists(path)) {
conditions_available <- c(conditions_available, cond)
}
}
if (length(conditions_available) == 0) {
stop("No valence data available for any condition")
}
cat("Loading available conditions:", paste(conditions_available, collapse = ", "), "\n")
load_valence_data(conditions = conditions_available)
})
# Prepare condition factor
df_combined <- df_combined %>%
prepare_condition_factor(reference = "human-ai")
# Report loaded data
cat("\nLoaded data summary:\n")
df_combined %>%
group_by(condition) %>%
summarise(
n_stories = n_distinct(conversation_id),
n_turns = n(),
.groups = "drop"
) %>%
print()
# Compute lagged valence for alignment analysis
df_analysis <- df_combined %>%
group_by(conversation_id, condition) %>%
arrange(turn) %>%
mutate(
author_1_valence_lag1 = lag(author_1_valence, n = 1),
author_2_valence_lag1 = lag(author_2_valence, n = 1)
) %>%
ungroup() %>%
filter(turn > 1) %>%
drop_na(author_1_valence, author_2_valence,
author_1_valence_lag1, author_2_valence_lag1)
cat("Analysis dataset:", nrow(df_analysis), "turns across",
n_distinct(df_analysis$conversation_id), "stories\n")
# Valence descriptives by condition
desc_stats <- df_analysis %>%
group_by(condition) %>%
summarise(
n_stories = n_distinct(conversation_id),
n_turns = n(),
mean_a1_valence = mean(author_1_valence, na.rm = TRUE),
sd_a1_valence = sd(author_1_valence, na.rm = TRUE),
mean_a2_valence = mean(author_2_valence, na.rm = TRUE),
sd_a2_valence = sd(author_2_valence, na.rm = TRUE),
.groups = "drop"
)
desc_stats %>%
knitr::kable(
digits = 3,
caption = "Valence descriptives by condition",
col.names = c("Condition", "Stories", "Turns",
"Author 1 M", "Author 1 SD",
"Author 2 M", "Author 2 SD")
)
# Valence distributions by condition
p_dist_a1 <- df_analysis %>%
ggplot(aes(x = author_1_valence, fill = condition)) +
geom_density(alpha = 0.5) +
scale_fill_manual(values = condition_colors) +
labs(title = "Author 1 Valence Distribution", x = "Valence", y = "Density") +
theme(legend.position = "none")
p_dist_a2 <- df_analysis %>%
ggplot(aes(x = author_2_valence, fill = condition)) +
geom_density(alpha = 0.5) +
scale_fill_manual(values = condition_colors) +
labs(title = "Author 2 Valence Distribution", x = "Valence", y = "Density")
p_dist_a1 + p_dist_a2 + plot_layout(guides = "collect")
# Fit models for each condition and direction
conditions <- unique(df_analysis$condition)
results_within <- tibble()
for (cond in conditions) {
df_cond <- filter(df_analysis, condition == cond)
# Skip if insufficient data
if (nrow(df_cond) < 50) {
cat("Skipping", cond, "- insufficient data\n")
next
}
# A2 → A1 model
m_a2_to_a1 <- tryCatch({
lmer(author_1_valence ~ author_2_valence_lag1 + (1 | conversation_id),
data = df_cond)
}, error = function(e) NULL)
# A1 → A2 model
m_a1_to_a2 <- tryCatch({
lmer(author_2_valence ~ author_1_valence + (1 | conversation_id),
data = df_cond)
}, error = function(e) NULL)
# Extract results
if (!is.null(m_a2_to_a1)) {
coefs <- summary(m_a2_to_a1)$coefficients
results_within <- bind_rows(results_within, tibble(
condition = cond,
direction = "A2 → A1",
estimate = coefs["author_2_valence_lag1", "Estimate"],
se = coefs["author_2_valence_lag1", "Std. Error"],
t = coefs["author_2_valence_lag1", "t value"],
p = coefs["author_2_valence_lag1", "Pr(>|t|)"]
))
}
if (!is.null(m_a1_to_a2)) {
coefs <- summary(m_a1_to_a2)$coefficients
results_within <- bind_rows(results_within, tibble(
condition = cond,
direction = "A1 → A2",
estimate = coefs["author_1_valence", "Estimate"],
se = coefs["author_1_valence", "Std. Error"],
t = coefs["author_1_valence", "t value"],
p = coefs["author_1_valence", "Pr(>|t|)"]
))
}
}
# Display results
results_within %>%
mutate(
sig = case_when(
p < 0.001 ~ "***",
p < 0.01 ~ "**",
p < 0.05 ~ "*",
p < 0.1 ~ ".",
TRUE ~ ""
),
ci_lower = estimate - 1.96 * se,
ci_upper = estimate + 1.96 * se
) %>%
select(condition, direction, estimate, se, ci_lower, ci_upper, t, p, sig) %>%
knitr::kable(
digits = 3,
caption = "Within-condition alignment coefficients"
)
# A2 → A1 with condition interaction
model_cross_a2_a1 <- lmer(
author_1_valence ~ author_2_valence_lag1 * condition + (1 | conversation_id),
data = df_analysis
)
cat("=== Cross-Condition: Author 2 → Author 1 ===\n")
print(summary(model_cross_a2_a1))
# A1 → A2 with condition interaction
model_cross_a1_a2 <- lmer(
author_2_valence ~ author_1_valence * condition + (1 | conversation_id),
data = df_analysis
)
cat("\n=== Cross-Condition: Author 1 → Author 2 ===\n")
print(summary(model_cross_a1_a2))
# Estimated marginal means and pairwise contrasts
if (length(unique(df_analysis$condition)) > 1) {
# A2 → A1 slopes by condition
emm_a2_a1 <- emtrends(model_cross_a2_a1, specs = "condition",
var = "author_2_valence_lag1")
cat("=== A2→A1 Alignment Slopes by Condition ===\n")
print(emm_a2_a1)
cat("\n=== Pairwise Contrasts (A2→A1) ===\n")
print(pairs(emm_a2_a1, adjust = "bonferroni"))
# A1 → A2 slopes by condition
emm_a1_a2 <- emtrends(model_cross_a1_a2, specs = "condition",
var = "author_1_valence")
cat("\n=== A1→A2 Alignment Slopes by Condition ===\n")
print(emm_a1_a2)
cat("\n=== Pairwise Contrasts (A1→A2) ===\n")
print(pairs(emm_a1_a2, adjust = "bonferroni"))
}
# Alignment slopes by condition
p1 <- df_analysis %>%
ggplot(aes(x = author_2_valence_lag1, y = author_1_valence, color = condition)) +
geom_point(alpha = 0.05, size = 0.5) +
geom_smooth(method = "lm", se = TRUE, linewidth = 1.2) +
scale_color_manual(values = condition_colors) +
labs(
title = "Author 2 → Author 1 Alignment",
subtitle = "Does Author 1 follow Author 2's previous valence?",
x = "Author 2 Valence (t-1)",
y = "Author 1 Valence (t)",
color = "Condition"
)
p2 <- df_analysis %>%
ggplot(aes(x = author_1_valence, y = author_2_valence, color = condition)) +
geom_point(alpha = 0.05, size = 0.5) +
geom_smooth(method = "lm", se = TRUE, linewidth = 1.2) +
scale_color_manual(values = condition_colors) +
labs(
title = "Author 1 → Author 2 Alignment",
subtitle = "Does Author 2 match Author 1's current valence?",
x = "Author 1 Valence (t)",
y = "Author 2 Valence (t)",
color = "Condition"
)
p1 + p2 + plot_layout(guides = "collect") &
theme(legend.position = "bottom")
# Coefficient comparison plot
if (nrow(results_within) > 0) {
results_within %>%
mutate(
ci_lower = estimate - 1.96 * se,
ci_upper = estimate + 1.96 * se
) %>%
ggplot(aes(x = condition, y = estimate, fill = condition)) +
geom_col(width = 0.6, alpha = 0.8) +
geom_errorbar(aes(ymin = ci_lower, ymax = ci_upper), width = 0.2) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
facet_wrap(~direction, scales = "free_x") +
scale_fill_manual(values = condition_colors) +
labs(
title = "Alignment Coefficients by Condition",
subtitle = "Error bars show 95% CI",
y = "Alignment Coefficient (β)",
x = "Condition"
) +
theme(legend.position = "none")
}
# Compare A2→A1 vs A1→A2 coefficients within each condition
asymmetry_results <- results_within %>%
select(condition, direction, estimate, se) %>%
pivot_wider(
names_from = direction,
values_from = c(estimate, se),
names_sep = "_"
) %>%
mutate(
diff = `estimate_A1 → A2` - `estimate_A2 → A1`,
diff_se = sqrt(`se_A1 → A2`^2 + `se_A2 → A1`^2),
z = diff / diff_se,
p = 2 * pnorm(-abs(z)),
interpretation = case_when(
p < 0.05 & diff > 0 ~ "A1→A2 stronger",
p < 0.05 & diff < 0 ~ "A2→A1 stronger",
TRUE ~ "No significant asymmetry"
)
)
asymmetry_results %>%
select(condition, diff, diff_se, z, p, interpretation) %>%
knitr::kable(
digits = 3,
caption = "Alignment asymmetry by condition (A1→A2 minus A2→A1)",
col.names = c("Condition", "Difference", "SE", "z", "p", "Interpretation")
)
# Final summary table
summary_table <- results_within %>%
mutate(
sig = case_when(
p < 0.001 ~ "***",
p < 0.01 ~ "**",
p < 0.05 ~ "*",
p < 0.1 ~ ".",
TRUE ~ "ns"
),
effect = paste0(round(estimate, 3), " (", round(se, 3), ") ", sig)
) %>%
select(condition, direction, effect) %>%
pivot_wider(names_from = direction, values_from = effect)
summary_table %>%
knitr::kable(caption = "Summary: Alignment effects by condition and direction (β (SE) sig)")
knitr::opts_chunk$set(
echo = FALSE,
warning = FALSE,
message = FALSE,
fig.width = 10,
fig.height = 6,
dpi = 300
)
# Load comparison utilities
source(here::here("analysis/comparison/_comparison_utils.R"))
# Additional packages
pacman::p_load(
lme4,         # Mixed effects models
lmerTest,     # P-values for mixed models
patchwork,    # Combine plots
emmeans       # Estimated marginal means
)
# Set global theme
theme_set(theme_comparison())
# Check data availability
cat("Data availability:\n")
avail <- check_data_availability()
print(avail)
# Load surface metrics
df_combined <- tryCatch({
load_surface_metrics(conditions = c("human-ai", "human-human", "ai-ai"))
}, error = function(e) {
cat("Error loading surface metrics:", e$message, "\n")
cat("Attempting to load from individual conditions...\n")
conditions_available <- c()
for (cond in c("human-ai", "human-human", "ai-ai")) {
path <- here("data", cond, "processed", "surface_metrics.parquet")
if (file.exists(path)) {
conditions_available <- c(conditions_available, cond)
}
}
if (length(conditions_available) == 0) {
stop("No surface metrics data available")
}
load_surface_metrics(conditions = conditions_available)
})
# Prepare condition factor
df_combined <- df_combined %>%
prepare_condition_factor(reference = "human-ai")
# Report loaded data
cat("\nLoaded data summary:\n")
df_combined %>%
group_by(condition) %>%
summarise(
n_stories = n_distinct(conversation_id),
n_turns = n(),
.groups = "drop"
) %>%
print()
# Identify available metrics
# Common surface metrics from textdescriptives
potential_metrics <- c(
# Length metrics
"n_tokens", "n_words", "n_chars", "n_sentences",
# Complexity
"avg_word_length", "avg_sentence_length", "n_syllables",
# Diversity
"ttr", "mtld", "hdd",
# Readability
"flesch_reading_ease", "flesch_kincaid_grade", "gunning_fog",
"smog", "automated_readability_index", "coleman_liau_index",
# Other
"n_unique_tokens", "entropy"
)
# Find which metrics are present
available_metrics <- intersect(potential_metrics, names(df_combined))
cat("Available metrics:", paste(available_metrics, collapse = ", "), "\n")
# Ensure we have at least some metrics
if (length(available_metrics) == 0) {
stop("No recognized surface metrics found in the data")
}
# Summary statistics by condition for key metrics
if ("n_tokens" %in% available_metrics || "n_words" %in% available_metrics) {
word_col <- if ("n_words" %in% available_metrics) "n_words" else "n_tokens"
desc_length <- df_combined %>%
group_by(condition) %>%
summarise(
n_turns = n(),
mean_words = mean(!!sym(word_col), na.rm = TRUE),
sd_words = sd(!!sym(word_col), na.rm = TRUE),
median_words = median(!!sym(word_col), na.rm = TRUE),
.groups = "drop"
)
desc_length %>%
knitr::kable(
digits = 2,
caption = "Word count by condition"
)
}
# Visualize distributions for key metrics
plot_metric_dist <- function(df, metric, title) {
if (!metric %in% names(df)) return(NULL)
ggplot(df, aes(x = !!sym(metric), fill = condition)) +
geom_density(alpha = 0.5) +
scale_fill_manual(values = condition_colors) +
labs(title = title, x = metric, y = "Density") +
theme(legend.position = "none")
}
# Create distribution plots for available metrics
plots <- list()
if ("n_words" %in% available_metrics) {
plots$words <- plot_metric_dist(df_combined, "n_words", "Word Count")
}
if ("n_tokens" %in% available_metrics && !("n_words" %in% available_metrics)) {
plots$tokens <- plot_metric_dist(df_combined, "n_tokens", "Token Count")
}
if ("avg_sentence_length" %in% available_metrics) {
plots$sent_len <- plot_metric_dist(df_combined, "avg_sentence_length", "Avg Sentence Length")
}
if ("ttr" %in% available_metrics) {
plots$ttr <- plot_metric_dist(df_combined, "ttr", "Type-Token Ratio")
}
if ("flesch_reading_ease" %in% available_metrics) {
plots$flesch <- plot_metric_dist(df_combined, "flesch_reading_ease", "Flesch Reading Ease")
}
if (length(plots) > 0) {
wrap_plots(plots, ncol = 2) +
plot_layout(guides = "collect") &
theme(legend.position = "bottom")
}
word_col <- if ("n_words" %in% available_metrics) "n_words" else
if ("n_tokens" %in% available_metrics) "n_tokens" else NULL
if (!is.null(word_col)) {
# Mixed model for word count
model_words <- lmer(
as.formula(paste(word_col, "~ condition + (1 | conversation_id)")),
data = df_combined
)
cat("=== Word Count by Condition ===\n")
print(summary(model_words))
# Pairwise contrasts
emm_words <- emmeans(model_words, specs = "condition")
cat("\n=== Estimated Marginal Means ===\n")
print(emm_words)
cat("\n=== Pairwise Contrasts ===\n")
print(pairs(emm_words, adjust = "bonferroni"))
}
knitr::opts_chunk$set(
echo = FALSE,
warning = FALSE,
message = FALSE,
fig.width = 10,
fig.height = 6,
dpi = 300
)
# Load comparison utilities
source(here::here("analysis/comparison/_comparison_utils.R"))
# Additional packages
pacman::p_load(
lme4,         # Mixed effects models
lmerTest,     # P-values for mixed models
patchwork,    # Combine plots
emmeans       # Estimated marginal means
)
# Set global theme
theme_set(theme_comparison())
# Check data availability
cat("Data availability:\n")
avail <- check_data_availability()
print(avail)
# Load exploration data
df_combined <- tryCatch({
load_exploration_data(conditions = c("human-ai", "human-human", "ai-ai"))
}, error = function(e) {
cat("Primary load failed:", e$message, "\n")
cat("Attempting fallback loading...\n")
conditions_available <- c()
for (cond in c("human-ai", "human-human", "ai-ai")) {
for (fname in c("semantic_exploration.parquet", "exploration_metrics.parquet", "novelty_scores.parquet")) {
path <- here("data", cond, "processed", fname)
if (file.exists(path)) {
conditions_available <- c(conditions_available, cond)
break
}
}
}
conditions_available <- unique(conditions_available)
if (length(conditions_available) == 0) {
stop("No exploration data available for any condition")
}
load_exploration_data(conditions = conditions_available)
})
